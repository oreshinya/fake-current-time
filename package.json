{
  "name": "fake-current-time",
  "version": "0.3.3",
  "description": "Manipulate current time in your application for development and staging environments",
  "keywords": [
    "time",
    "date",
    "offset",
    "manipulation",
    "development",
    "staging",
    "simulation"
  ],
  "author": "oreshinya",
  "license": "MIT",
  "repository": "oreshinya/fake-current-time",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc",
    "lint:ci": "biome ci ./src",
    "lint:fix": "biome check --write ./src",
    "test": "vitest run",
    "build": "tsdown"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsdown": "^0.22.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.13.1+sha512.b2fc7683b8a6525414e7d13e1ba28caaddde96bf66ec540bfaeb7e702b81f3e0be4d1f295edf7f9fe0396740a8dce4509c582ddf79891f4543fea32d37645f25"
}
